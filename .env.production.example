# Configure these values in Render, never in a committed production file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PUBLIC_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

SECRET_KEY=generate-a-long-random-production-secret
ANALYTICS_HASH_KEY=generate-a-separate-long-random-secret
TOKEN_EXPIRE_MINUTES=480
SESSION_IDLE_MINUTES=30
USER_READ_RATE_LIMIT=120
USER_WRITE_RATE_LIMIT=30
USER_UPLOAD_RATE_LIMIT=6
USER_SENSITIVE_RATE_LIMIT=10
APPROVAL_LINK_HOURS=72
ADMIN_NAME=Administrador del sistema
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-secure-production-password

EMAIL_MODE=brevo
BREVO_API_KEY=
BREVO_SENDER_NAME=PH · Gestión de Gastos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_STORAGE_MB=450
