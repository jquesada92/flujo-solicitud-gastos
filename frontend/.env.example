# =============================================================================
# FRONTEND · React + Vite
# Local: copia como frontend/.env.
# Vercel: configura estas variables para Production y Preview.
# Todo valor VITE_* es público en el navegador; nunca contiene secretos.
# =============================================================================

# Local con Vite directo: http://localhost:8000
# Docker local con proxy Nginx: deja el valor vacío.
# Vercel: usa la URL HTTPS pública de Render sin barra final.
VITE_API_URL=

# Zona horaria utilizada para presentar fechas y horas.
VITE_TIME_ZONE=America/Panama
