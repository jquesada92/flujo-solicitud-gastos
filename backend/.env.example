# =============================================================================
# BACKEND · FastAPI
# Local fuera de Docker: copia como backend/.env solo si ya tienes PostgreSQL
# local. El camino soportado del repositorio es Docker Compose, que reemplaza
# conexión, URLs y modo de correo. Nunca reutilices este archivo en producción.
# =============================================================================

# --- Entorno y conexiones ----------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://ph_user:ph_password@localhost:5432/ph_torre_delta
DATABASE_SCHEMA=administracion
PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_TIME_ZONE=America/Panama

# Producción se configura en la plataforma, no copiando esta plantilla.
# Consulta docs/VALIDACION_PRODUCCION.md y docs/NEON_SETUP.md.

# --- Seguridad y sesiones ----------------------------------------------------
SECRET_KEY=development-only-change-this-key-32-chars
ANALYTICS_HASH_KEY=development-only-change-analytics-key
TOKEN_EXPIRE_MINUTES=480
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SESSION_IDLE_MINUTES=10

# --- Límites de API ----------------------------------------------------------
USER_READ_RATE_LIMIT=120
USER_WRITE_RATE_LIMIT=30
USER_UPLOAD_RATE_LIMIT=6
USER_SENSITIVE_RATE_LIMIT=10

# --- Correo ------------------------------------------------------------------
# Local seguro: console. Puede escribir cuerpos completos en logs, por lo que
# se usa únicamente con datos de prueba. Nunca habilites SMTP/Brevo por accidente.
EMAIL_MODE=console
EMAIL_FROM=noreply@example.test
BREVO_API_KEY=
BREVO_SENDER_NAME=Gestión de Solicitudes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=

# Alternativa Google soportada si se prefiere STARTTLS:
# SMTP_PORT=587
# SMTP_SECURITY=starttls

# Producción recomendada: Brevo HTTPS.
# EMAIL_MODE=brevo
# EMAIL_FROM=< REMITENTE_VERIFICADO >
# BREVO_API_KEY=< SECRET >

# --- Bootstrap local ---------------------------------------------------------
# Cambia estos valores antes del primer arranque si vas a iniciar sesión.
# No son válidos para preview público ni producción.
ADMIN_NAME=Administrador local
ADMIN_EMAIL=admin.local@example.test
ADMIN_PASSWORD=local-only-change-before-first-start

# --- Almacenamiento privado --------------------------------------------------
# En Docker y Render el volumen persistente se monta en /app/uploads.
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_STORAGE_MB=450
