# =============================================================================
# BACKEND · FastAPI
# Local: copia como backend/.env y conserva los valores de desarrollo.
# Render: configura las mismas variables en el panel con valores de producción.
# =============================================================================

# --- Entorno y conexiones ----------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://ph_user:< CONTRASEÑA LOCAL >@localhost:5432/ph_expenses
PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_TIME_ZONE=America/Panama

# En Render usa:
# ENVIRONMENT=production
# DATABASE_URL=< URL PRIVADA DE CONEXION A NEON >
# PUBLIC_URL=< URL HTTPS DEL FRONTEND EN VERCEL >
# CORS_ALLOWED_ORIGINS=< URL HTTPS DEL FRONTEND EN VERCEL >

# --- Seguridad y sesiones ----------------------------------------------------
SECRET_KEY=development-only-change-this-key-32-chars
ANALYTICS_HASH_KEY=development-only-change-analytics-key
TOKEN_EXPIRE_MINUTES=480
SESSION_IDLE_MINUTES=30

# --- Límites, paginación y consultas -----------------------------------------
USER_READ_RATE_LIMIT=120
USER_WRITE_RATE_LIMIT=30
USER_UPLOAD_RATE_LIMIT=6
USER_SENSITIVE_RATE_LIMIT=10
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
SEARCH_MIN_CHARS=2
QUERY_TIMEOUT_MS=5000

# --- Administrador técnico inicial -------------------------------------------
ADMIN_NAME=Administrador del sistema
ADMIN_EMAIL=admin-local@example.test
ADMIN_PASSWORD=LocalOnly123!

# --- Correo ------------------------------------------------------------------
# Local recomendado: Gmail / Google Workspace SMTP con App Password.
# Requiere 2-Step Verification en la cuenta Google para crear una App Password.
# EMAIL_FROM y SMTP_USER deben ser la misma cuenta para evitar inconsistencias
# de remitente durante las pruebas locales.
EMAIL_MODE=smtp
EMAIL_FROM=< TU_CORREO_GMAIL_O_WORKSPACE >
BREVO_API_KEY=
BREVO_SENDER_NAME=Gestión de Solicitudes

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=< TU_CORREO_GMAIL_O_WORKSPACE >
SMTP_PASSWORD=< APP_PASSWORD_DE_GOOGLE >

# Alternativa Google soportada si se prefiere STARTTLS:
# SMTP_PORT=587
# SMTP_SECURITY=starttls

# Producción recomendada: Brevo HTTPS.
# EMAIL_MODE=brevo
# EMAIL_FROM=< REMITENTE_VERIFICADO >
# BREVO_API_KEY=< SECRET >

# --- Almacenamiento privado --------------------------------------------------
# En Docker y Render el volumen persistente se monta en /app/uploads.
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_STORAGE_MB=450
