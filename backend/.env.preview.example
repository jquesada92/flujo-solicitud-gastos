# =============================================================================
# BACKEND · Preview local con túnel temporal
# El script start-preview.ps1 copia este archivo como backend/.env.preview.
# Todos los valores son exclusivos de desarrollo y no sirven para producción.
# =============================================================================

ENVIRONMENT=development
# Docker Compose reemplaza DATABASE_URL con la conexión al contenedor PostgreSQL.
DATABASE_URL=postgresql+psycopg://preview:preview@db:5432/ph_expenses_preview
PUBLIC_URL=https://replace-with-your-tunnel.trycloudflare.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_TIME_ZONE=America/Panama

SECRET_KEY=preview-only-change-this-key-32-characters
ANALYTICS_HASH_KEY=preview-only-change-this-analytics-key
TOKEN_EXPIRE_MINUTES=480
SESSION_IDLE_MINUTES=30

USER_READ_RATE_LIMIT=120
USER_WRITE_RATE_LIMIT=30
USER_UPLOAD_RATE_LIMIT=6
USER_SENSITIVE_RATE_LIMIT=10
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
SEARCH_MIN_CHARS=2
QUERY_TIMEOUT_MS=5000

ADMIN_NAME=Administrador del sistema
ADMIN_EMAIL=admin-preview@example.test
ADMIN_PASSWORD=PreviewOnly123!

EMAIL_MODE=console
EMAIL_FROM=noreply@example.test
BREVO_API_KEY=
BREVO_SENDER_NAME=PH · Gestión de Gastos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_STORAGE_MB=450
