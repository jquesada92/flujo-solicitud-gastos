# Development only: PostgreSQL runs in Docker.
POSTGRES_DB=ph_expenses
POSTGRES_USER=ph_user
POSTGRES_PASSWORD=change-me-local

TREASURER_EMAIL=tesorero@tuph.com
PRESIDENT_EMAIL=presidente@tuph.com

# console = imprime correos en logs del backend (ideal para desarrollo)
# smtp = envía correos realmente
EMAIL_MODE=console
BREVO_API_KEY=
BREVO_SENDER_NAME=PH · Gestión de Gastos

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Development credentials only. Production values live in Render.
SECRET_KEY=change-this-for-a-long-random-secret
ANALYTICS_HASH_KEY=change-this-for-a-separate-analytics-hmac-key
TOKEN_EXPIRE_MINUTES=480
SESSION_IDLE_MINUTES=30
USER_READ_RATE_LIMIT=120
USER_WRITE_RATE_LIMIT=30
USER_UPLOAD_RATE_LIMIT=6
USER_SENSITIVE_RATE_LIMIT=10
APPROVAL_LINK_HOURS=72
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tuph.com
ADMIN_PASSWORD=change-this-password
MAX_UPLOAD_STORAGE_MB=450
