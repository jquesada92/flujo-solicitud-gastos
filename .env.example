# =============================================================================
# DOCKER COMPOSE · Infraestructura local aislada
# Copia este archivo como .env en la raíz únicamente si necesitas overrides.
# Compose usa su propio PostgreSQL y no necesita Neon ni credenciales externas.
# Nunca copies aquí valores de producción.
# =============================================================================

# Archivo opcional de variables locales utilizado por el contenedor; está
# ignorado por Git y no debe reutilizar secretos de otro ambiente.
# docker-compose.yml reemplaza DATABASE_URL, DATABASE_SCHEMA, PUBLIC_URL,
# CORS_ALLOWED_ORIGINS y EMAIL_MODE con valores locales seguros.
BACKEND_ENV_FILE=./backend/.env

# URL pública del frontend cuando se usa Docker Compose.
# El correo usa esta URL para construir enlaces de restablecimiento,
# aprobación y votación.
# Docker publica Nginx en localhost:3000; 5173 corresponde a Vite directo.
LOCAL_PUBLIC_URL=http://localhost:3000
LOCAL_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Argumento de compilación del frontend local
VITE_TIME_ZONE=America/Panama
