# =============================================================================
# DOCKER COMPOSE · Infraestructura local
# Copia este archivo como .env en la raíz.
# Las variables de aplicación y la conexión DEV viven en backend/.env.
# =============================================================================

# Archivo de variables utilizado por el contenedor backend.
# backend/.env debe contener DATABASE_URL de Neon DEV y
# DATABASE_SCHEMA=administracion.
BACKEND_ENV_FILE=./backend/.env

# URL pública del frontend cuando se usa Docker Compose.
# El correo usa esta URL para construir links de aprobación/votación.
# Docker publica Nginx en localhost:3000; 5173 corresponde a Vite directo.
LOCAL_PUBLIC_URL=http://localhost:3000
LOCAL_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Argumento de compilación del frontend local
VITE_TIME_ZONE=America/Panama
