# Development only: PostgreSQL runs in Docker.
POSTGRES_DB=ph_expenses
POSTGRES_USER=ph_user
POSTGRES_PASSWORD=< CONTRASEÑA LOCAL DE POSTGRES >

TREASURER_EMAIL=< CORREO DEL TESORERO >
PRESIDENT_EMAIL=< CORREO DEL PRESIDENTE >

# console = imprime correos en logs del backend (ideal para desarrollo)
# smtp = envía correos realmente
EMAIL_MODE=console
BREVO_API_KEY=< CLAVE API DE BREVO >
BREVO_SENDER_NAME=PH · Gestión de Gastos

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=< USUARIO SMTP >
SMTP_PASSWORD=< CONTRASEÑA SMTP >
EMAIL_FROM=< CORREO REMITENTE VERIFICADO >

PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Development credentials only. Production values live in Render.
SECRET_KEY=< CLAVE ALEATORIA DE AL MENOS 32 CARACTERES >
ANALYTICS_HASH_KEY=< OTRA CLAVE ALEATORIA DE AL MENOS 32 CARACTERES >
TOKEN_EXPIRE_MINUTES=480
SESSION_IDLE_MINUTES=30
USER_READ_RATE_LIMIT=120
USER_WRITE_RATE_LIMIT=30
USER_UPLOAD_RATE_LIMIT=6
USER_SENSITIVE_RATE_LIMIT=10
APPROVAL_LINK_HOURS=72
ADMIN_NAME=Administrador
ADMIN_EMAIL=< CORREO DEL ADMINISTRADOR >
ADMIN_PASSWORD=< CONTRASEÑA SEGURA DEL ADMINISTRADOR >
MAX_UPLOAD_STORAGE_MB=450
