# Neon PostgreSQL. Never commit the real password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

TREASURER_EMAIL=tesorero@tuph.com
PRESIDENT_EMAIL=presidente@tuph.com

# console = imprime correos en logs del backend (ideal para desarrollo)
# smtp = envía correos realmente
EMAIL_MODE=console

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cambiar obligatoriamente antes de desplegar
SECRET_KEY=change-this-for-a-long-random-secret
TOKEN_EXPIRE_MINUTES=480
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tuph.com
ADMIN_PASSWORD=change-this-password
